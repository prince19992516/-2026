Z = X**4 + Y**4 - 2*X**2 - 2*Y**2 + 0.5*X + 0.5*Y
plt.figure(figsize=(6,5))
plt.contour(X, Y, Z, levels=40, cmap='viridis')
plt.plot(xs[:,0], xs[:,1], 'o-', color='tab:red', markersize=3, label='阻尼 Newton')
plt.xlabel('x'); plt.ylabel('y'); plt.legend(); plt.grid(True)
plt.title('阻尼 Newton：Hessian 修正 + Armijo 回溯')
plt.show()
